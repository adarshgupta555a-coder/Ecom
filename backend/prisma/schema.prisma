// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// use prisma-7
model Country {
  id         Int       @id @default(autoincrement())
  name       String
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)

  states State[]

  @@map("country")
}

model State {
  id         Int       @id @default(autoincrement())
  name       String
  country_id Int
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)

  country Country @relation(fields: [country_id], references: [id], onDelete: Cascade)

  cities City[]

  @@map("state")
}

model City {
  id         Int       @id @default(autoincrement())
  name       String
  state_id   Int
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)

  state         State         @relation(fields: [state_id], references: [id], onDelete: Cascade)
  UserAddresses UserAddress[]

  @@index([id])
  @@map("city")
}

enum ROLE {
  ADMIN
  VENDOR
  MANAGER
  WAREHOUSE
  CUSTOMER
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  fullname      String
  phone         String
  role          ROLE      @default(CUSTOMER)
  address_id    Int?
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at    DateTime? @db.Timestamptz(3)

  addresses UserAddress[]
  Carts     Cart[]
  Sessions  DeviceSession[]

  @@map("user")
}

model UserAddress {
  id         Int       @id @default(autoincrement())
  user_id    Int
  address    String
  city_id    Int
  pincode    String
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  city City @relation(fields: [city_id], references: [id], onDelete: Cascade)

  @@map("user_address")
}

// =======================================================
// AUTH
// =======================================================

enum BAN_REASON {
  USER_CALL
  TOKEN_REUSE
  SECURITY
}

model RefreshToken {
  id             Int       @id @default(autoincrement())
  session_id     Int
  token_hash     String
  next_token_id  Int?
  expires        DateTime  @db.Timestamptz(3)
  revoked_at     DateTime? @db.Timestamptz(3)
  revoked__by_ip String    @db.Inet
  created_at     DateTime  @default(now()) @db.Timestamptz(3)
  updated_at     DateTime? @db.Timestamptz(3)

  session     DeviceSession  @relation(fields: [session_id], references: [id])
  // next_token  RefreshToken   @relation(fields: [next_token_id], references: [id])
  // refeshToken RefreshToken[]

  @@map("refresh_token")
}

model DeviceSession {
  id         Int       @id @default(autoincrement())
  user_id    Int
  browser    String
  platform   String
  user_agent String
  ip_address String    @db.Inet
  revoked_at DateTime? @db.Timestamptz(3)
  banned_at  DateTime? @db.Timestamptz(3)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)

  ban_reason     BAN_REASON
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@map("device_session")
}

// 

enum STATUS_P {
  ACTIVE
  INACTIVE
}

model Product {
  id           Int       @id @default(autoincrement())
  product_name String
  description  String
  price        Decimal   @db.Decimal(10, 2)
  is_deleted   Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime? @db.Timestamptz(3)

  product_variant ProductVariant[]
  cart_item       CartItem[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  categoryId      Int?

  @@map("product")
}

model ProductVariant {
  id                   Int      @id @default(autoincrement())
  product_variant_name String
  model_id             Int
  product_id           Int
  price                Decimal  @db.Decimal(10, 2)
  created_at           DateTime @db.Timestamptz(3)
  updated_at           DateTime @db.Timestamptz(3)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  model   Model   @relation(fields: [model_id], references: [id], onDelete: Cascade)

  cart_item CartItem[]

  @@map("product_variant")
}

model Model {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @db.Timestamptz(3)

  product_variant ProductVariant[]
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String
  url_slug   String
  cate_id    Int
  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @db.Timestamptz(3)

  products Product[]
}

model Cart {
  id      Int @id @default(autoincrement())
  user_id Int

  cart_user User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  order     Order[]
  orderId   Int

  @@map("cart")
}

model CartItem {
  id                 Int            @id @default(autoincrement())
  cart_id            Int
  product_id         Int
  amount             Decimal        @db.Decimal(10, 2)
  product_variant_id Int
  quantity           Int
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  product            Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart               Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@map("cart_item")
}

enum DISCOUNT_TYPE {
  FIXED
  PERCENT
}

enum STATUS_ORDER {
  PENDING
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  OUT_OF_DELIVERY
  DELIVERED
  COMPLETED
  REFUNDED
  CANCELED
  // Pending Payment
  // Processing
  // Awaiting Fulfillment
  // Shipped
  // Dispatched
  // In Transit
  // Out for Delivery
  // Delivered
  // Attempted Delivery
  // Ready for Pickup
  // Completed
  // Delayed
  // Held at Customs
  // On Hold
  // Canceled
  // Refunded
}

enum PAYMENT_MODE {
  CASH
  CARD
  UPI
}

model Coupon {
  id Int @id @default(autoincrement())

  @@map("coupon")
}

model Order {
  id              Int           @id @default(autoincrement())
  cart_id         Int
  coupon_id       Int
  discount_amount Decimal       @db.Decimal(10, 2)
  discount_type   DISCOUNT_TYPE @default(FIXED)
  final_amount    Decimal       @db.Decimal(10, 2)
  status          STATUS_ORDER  @default(PENDING)

  cart      Cart     @relation(fields: [cart_id], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id])
  paymentId Int?
}

enum PAYMENT_STATUS {
  PAID
  UNPAID
  FAILED
}

model Payment {
  id             Int            @id @default(autoincrement())
  transaction_id String
  order_id       Int
  payment_status PAYMENT_STATUS @default(UNPAID)
  payment_mode   PAYMENT_MODE

  order Order[]
}
